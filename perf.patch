+  if type(DiskCache.has) == "function" then
+    local okHas, hit = pcall(DiskCache.has, map, slot, masks)
+    if okHas and hit then return end
+  end
+  local job = { id = map.id, map = map, slot = slot, masks = masks,
+                region = "writeback", co = nil }
+  warmIndex[key] = job
